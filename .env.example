# =============================================================================
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# The .env file should NEVER be committed to version control
#
# Usage:
#   1. Copy: cp .env.example .env
#   2. Fill in your actual API keys and sensitive data
#   3. Keep .env in .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Environment Settings
# -----------------------------------------------------------------------------
# Options: development, staging, production
ENVIRONMENT=development

# Enable debug mode (true/false)
DEBUG=true

# Logging configuration
LOG_LEVEL=INFO
USE_JSON_LOGGING=false

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection URL
# Format: postgresql://username:password@host:port/database
DB_URL=postgresql://localhost:5432/movies

# -----------------------------------------------------------------------------
# API Keys (SENSITIVE - Do not commit!)
# -----------------------------------------------------------------------------
# The Movie Database (TMDB) API Key
# Get yours at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Open Movie Database (OMDB) API Key
# Get yours at: http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# API rate limiting (requests per second)
API_RATE_LIMIT=40

# API request timeout (seconds)
API_TIMEOUT=30

# -----------------------------------------------------------------------------
# Data Processing
# -----------------------------------------------------------------------------
# Batch size for data processing operations
BATCH_SIZE=100

# Random seed for reproducibility
RANDOM_SEED=42

# -----------------------------------------------------------------------------
# Data Collection Settings
# -----------------------------------------------------------------------------
# Maximum number of movies to collect from TMDB per run
# Set to 0 or leave commented for unlimited (uses config file default)
# TMDB_MAX_MOVIES=1000

# Maximum number of movies to collect from OMDB per run
# OMDB free tier has a 1000 request/day limit
# OMDB_MAX_MOVIES=1000

# Minimum TMDB popularity score for movie collection (float)
# Popular blockbusters: 50+, Mainstream: 10-50, Niche/indie: 1-10
# TMDB_MIN_POPULARITY=10.0

# Minimum number of votes required for movie collection (integer)
# High quality: 200+, Balanced: 50-100, Comprehensive: 10-50
# TMDB_MIN_VOTE_COUNT=50

# Minimum release year for movie collection (integer)
# Focus on modern cinema by setting to 1990 or 2000
# TMDB_MIN_RELEASE_YEAR=1950

# Allowed release statuses (comma-separated list)
# Options: Released, Post Production, In Production, Planned, Rumored, Canceled
# TMDB_ALLOWED_RELEASE_STATUSES=Released,Post Production,In Production

# -----------------------------------------------------------------------------
# FastAPI Server Configuration
# -----------------------------------------------------------------------------
# Server host (use 0.0.0.0 for production, localhost for dev)
HOST=0.0.0.0

# Server port
PORT=8000

# Auto-reload on code changes (development only)
RELOAD=true

# -----------------------------------------------------------------------------
# Azure Deployment (Optional - for production)
# -----------------------------------------------------------------------------
# Azure Subscription ID
# AZURE_SUBSCRIPTION_ID=your_azure_subscription_id

# Azure Resource Group
# AZURE_RESOURCE_GROUP=your_resource_group_name

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=Are You Not Entertained
